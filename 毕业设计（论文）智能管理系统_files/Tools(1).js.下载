//验证页面输入
var VerificationForm = function (form1) {
    var fm = form1;
    for (var i = 0; i < fm.length; i++) {
        var id = fm[i].id;
        if (id == "JieDuanNeiRong") {
            id = "JieDuan";
        }
        else if (id == "") {
            id = fm[i].name;
        }

        var title = fm[i].title;
        if (title == "") continue;//忽略未定义title的元素
        var p = title.lastIndexOf("~");
        if (p < 0) continue;//忽略title中未定义检查格式的元素
        var info = title.substring(0, p);
        var format = title.substring(p + 1, title.length);
        var name = fm[i].name;
        if (name == "") continue;//忽略没有名字的元素
        var value = trim(fm[i].value);

        if ($('div[columnid="' + id + '"]').css("display") != "none") {
            var notNull = false;
            if (format.charAt(format.length - 1) == "!") {
                notNull = true;
                format = format.substring(0, format.length - 1);
            }
            if (notNull) {
                if (value == "") {
                    SweetAlert.Warning(info + "\n其内容不可以为空。");
                    try {
                        fm[i].focus();
                    }
                    catch (e) {
                    }
                    finally {

                    }
                    return false;
                }
            }
            else { //内容可以为空时， 
                if (value == "")
                    continue;
            }
            var colonP = format.indexOf(":");
            var lengthLimit = 0;
            if (colonP > 0) {
                lengthLimit = format.substring(colonP + 1, format.length);
                format = format.substring(0, colonP);
            }
            console.log(lengthLimit);
            console.log(format);

            if (format == "email") {
                //电子邮件格式
                var found = value.match(/\w+@.+\..+/);
                if (found == null) {
                    SweetAlert.Warning(info + "\n其格式不正确:\n\"" + value + "\"不是一个Email地址");
                    fm[i].focus();
                    return false;
                }
            }
            else if (format == "int") {
                //整数
                var intVal = parseInt(value);
                if (isNaN(intVal) || intVal != value || intVal < 0) {
                    SweetAlert.Warning(info + "\n其格式不正确:\n" + value + "不是一个大于等于0的正整数。");
                    fm[i].focus();
                    return false;
                }
                if (!isNaN(lengthLimit)) {
                    if (parseInt(value) > parseInt(lengthLimit)) {
                        SweetAlert.Warning(info + "\n其值(" + value + ")超过限制" + lengthLimit);
                        fm[i].focus();
                        return false;
                    }
                }
            }
            else if (format == "float") {
                //浮点数
                var floatVal = parseFloat(value);
                if (isNaN(floatVal) || floatVal != value) {
                    SweetAlert.Warning(info + "\n其格式不正确:\n" + value + "不是一个浮点数。");
                    fm[i].focus();
                    return false;
                }
            }
            else if (format == "date") {
                //日期
                var found = value.match(/(\d{1,5})-(\d{1,2})-(\d{1,2})/);
                var found2 = value.match(/(\d{1,5})\/(\d{1,2})\/(\d{1,2})/);
                if (found == null || found[0] != value || found[2] > 12 || found[3] > 31) {
                    if (found2 == null || found2[0] != value || found2[2] > 12 || found2[3] > 31) {
                        SweetAlert.Warning(info + "\n其格式不正确:\n\"" + value + "\"不是一个日期\n提示：[2000-01-01]");
                        fm[i].focus();
                        return false;
                    }
                }
                var year = trim0(found[1]);
                var month = trim0(found[2]) - 1;
                var date = trim0(found[3]);
                var d = new Date(year, month, date);
                if (d.getFullYear() != year || d.getMonth() != month || d.getDate() != date) {
                    SweetAlert.Warning(info + "\n其内容不正确:\n\"" + value + "\"不是一个正确的日期\n提示：[2000-01-01]");
                    fm[i].focus();
                    return false;
                }
            }
            else if (format == "time") {
                //时间
                var found = value.match(/(\d{2}):(\d{2}):(\d{2})/);
                if (found == null || found[0] != value || found[1] > 23 || found[2] > 59 || found[3] > 59) {
                    SweetAlert.Warning(info + "\n其格式不正确:\n\"" + value + "\"不是一个时间\n提示：[05:38:00]");
                    fm[i].focus();
                    return false;
                }
            }
            else if (format == "hasChinese") {
                var _hasChinese = false;
                for (var j = 0; j < value.length; j++) {
                    if (value.charCodeAt(j) > 255) {
                        _hasChinese = true;
                        break;
                    }
                }
                if (!_hasChinese) {
                    SweetAlert.Warning(info + "\n其内容需要中文:\n\"" + value + "\"不含有任何中文字符");
                    fm[i].focus();
                    return false;
                }
            }
            else if (format == "allChinese") {
                for (var j = 0; j < value.length; j++) {
                    if (value.charCodeAt(j) <= 255) {
                        SweetAlert.Warning(info + "\n其内容要求全中文:\n\"" + value + "\"含有非中文字符");
                        fm[i].focus();
                        return false;
                    }
                }
            }
            else if (format == "noChinese") {
                for (var j = 0; j < value.length; j++) {
                    if (value.charCodeAt(j) > 255) {
                        SweetAlert.Warning(info + "\n其内容要求非中文:\n\"" + value + "\"含有中文字符");
                        fm[i].focus();
                        return false;
                    }
                }
            }
            //输入最小字数 minLength:200
            else if (format == "minLength") {
                //内容的值的大小判断
                if (!isNaN(lengthLimit)) {
                    if (value.length < parseInt(lengthLimit)) {
                        SweetAlert.Warning(info + "\n其值输入不得少于" + lengthLimit + "字。");
                        fm[i].focus();
                        return false;
                    }
                }
            }
            else if (format != "") {
                //自定义
                try {
                    var found = value.match(eval(format));
                    if (found == null || found[0] != value) {
                        SweetAlert.Warning(info + "\n其格式不不符合要求:\"" + value + "\"\n提示：[" + format + "]");
                        fm[i].focus();
                        return false;
                    }
                }
                catch (e) {
                    SweetAlert.Warning(e.name + ":\n不合法的正则式\"" + format + "\"");
                    return false;
                }
            }
        }
    }
    return true;
}

