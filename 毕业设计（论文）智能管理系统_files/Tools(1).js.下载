//验证
var Check = {
    //金钱格式数字验证
    Money: function (value) {
        var reg = /(^[1-9]([0-9]+)?(\.[0-9]{1,2})?$)|(^(0){1}$)|(^[0-9]\.[0-9]([0-9])?$)/;
        return reg.test(value);
    },
    Number: function (control) {
        if ($(control).val().length == 1) {
            $(control).val($(control).val().replace(/[^0-9]/g, ''));
        } else {
            if ($(control).val().substring(0, 1) == "0") {
                $(control).val("0");
            }
            else {
                $(control).val($(control).val().replace(/\D/g, ''));
            }
        }
    },
    Age: function (control) {
        if ($(control).val().length == 1) {
            $(control).val($(control).val().replace(/[^1-9]/g, ''));
        } else {
            $(control).val($(control).val().replace(/\D/g, ''));
        }
    },
    //验证电话号码
    Phone: function (value) {
        var reg = /^1[3|4|5|8][0-9]\d{4,8}$/;
        return reg.test(value);
    },
    //验证邮箱
    Email: function (value) {
        console.log(value);
        var reg = /\w@\w*\.\w/;
        return reg.test(value);
    },
    //身份证验证
    IDCard: function (idNumber) {
        var reg = /(^\d{15}$)|(^\d{18}$)|(^\d{17}(\d|X|x)$)/;
        return reg.test(idNumber);
    },
    //验证数字，num 小数位数
    ValidationNumber: function (e, num) {
        var regu = /^[0-9]+\.?[0-9]*$/;
        if (e.value != "") {
            if (!regu.test(e.value)) {
                alert("请输入正确的数字");
                e.value = e.value.substring(0, e.value.length - 1);
                e.focus();
            } else {
                if (num == 0) {
                    if (e.value.indexOf('.') > -1) {
                        e.value = e.value.substring(0, e.value.length - 1);
                        e.focus();
                    }
                }
                if (e.value.indexOf('.') > -1) {
                    if (e.value.split('.')[1].length > num) {
                        e.value = e.value.substring(0, e.value.length - 1);
                        e.focus();
                    }
                }

            }
        }
    }
}


var Tools = {
    //网络请求
    Net: {
        //Get请求
        Get: function (_url, Response) {

            //成功回调
            var SuccessFunction = function (Result, State, JQXHR) {
                Result = JsAESDecrypt(Result);
                Response.Success(Result);
            };
            //失败回调
            var ErrorFunction = function (Result, State, JQXHR) {
                console.log(Result);
            };
            $.ajax({
                type: "GET",
                url: _url,
                success: SuccessFunction,
                error: ErrorFunction,
                contentType: "text/plain; charset=utf-8"
            });
        },
        //Post请求
        Post: function (_url, Reqeuest, Response) {
            //成功回调
            var SuccessFunction = function (Result, State, JQXHR) { 
                Result = JsAESDecrypt(Result);
                Response.Success(Result);
            };
            //失败回调
            var ErrorFunction = function (Result, State, JQXHR) {
                console.log(Result);
            };
            $.ajax({
                type: "POST",
                url: _url,
                data: "JsonData=" + escape(JSON.stringify(Reqeuest)),
                success: SuccessFunction,
                error: ErrorFunction
            });
        }
    }
}

//替换html标签
var ReplaceHtmlTag = function (value) {
    value = value.replace(/(\n)/g, "");
    value = value.replace(/(\t)/g, "");
    value = value.replace(/(\r)/g, "");
    value = value.replace(/<\/?[^>]*>/g, "");
    value = value.replace(/\s*/g, "");
    return value;
}

