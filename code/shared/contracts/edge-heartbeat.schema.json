{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EdgeHeartbeat",
  "type": "object",
  "required": ["device_code", "reported_at", "status"],
  "properties": {
    "device_code": {
      "type": "string"
    },
    "reported_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": ["online", "degraded", "offline"]
    },
    "ip_address": {
      "type": ["string", "null"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
