{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InferenceResponse",
  "type": "object",
  "required": [
    "request_id",
    "service",
    "model_name",
    "model_version",
    "inference_source",
    "processed_at",
    "behavior_events"
  ],
  "properties": {
    "request_id": {
      "type": "string"
    },
    "service": {
      "type": "string"
    },
    "model_name": {
      "type": "string"
    },
    "model_version": {
      "type": "string"
    },
    "inference_source": {
      "type": "string"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time"
    },
    "behavior_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["behavior_type", "cow_count", "confidence"],
        "properties": {
          "behavior_type": {
            "type": "string"
          },
          "cow_count": {
            "type": "integer",
            "minimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "zone_name": {
            "type": ["string", "null"]
          },
          "notes": {
            "type": ["string", "null"]
          }
        },
        "additionalProperties": false
      }
    },
    "raw_metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
